# Rust / Cargo
# Ignore compiled artifacts everywhere
/target/
**/target/

# (Опция) Cargo.lock:
# - Если у вас workspace с приложениями — обычно стоит коммитить top-level Cargo.lock -> не игнорировать.
# - Если это библиотечный монорепо, можно игнорировать per-crate Cargo.lock.
# Уберите следующую строку если хотите коммитить Cargo.lock
# /Cargo.lock

# Editor and OS
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Temporary / build helpers
.Cargo.lock.tmp
.cargo/

# Debug / symbols (Windows)
*.pdb
*.exe

# Test outputs and local runtime artifacts
*.sqlite
*.db
*.log
snippets_test*.json

# Backup nested git repos if you renamed .git to .git.bak
**/.git.bak/